+# SharkVNTyper M3 - FASTQ already restricted to MUC1 reads (shark): fastp then Kestrel,
+# no alignment. fastp parameters are those of VNtyper 1.1.0/1.2.0 --fastq mode. As in
+# those versions, Kestrel reads the RAW input reads by default (fastp output = QC report
+# only); --use_qc_reads gives Kestrel the fastp-filtered reads instead (1.3.0 behaviour).
+if args.fastq and args.skip_alignment:
+    fastq_1 = args.fastq1
+    fastq_2 = args.fastq2
+    log_and_print("--skip_alignment: fastp QC (deduplication, length >= 40) without alignment (SharkVNTyper)\n")
+    QC_command = "fastp " + "--thread " + args.threads + " " + "--in1 " + fastq_1 + " --in2 " + fastq_2 + " --out1 " + output + args.output + "_R1.fastq.gz" + " " + "--out2 " + output + args.output + "_R2.fastq.gz" + " --compression 6 --disable_adapter_trimming --dedup --dup_calc_accuracy 3 --length_required 40 --html " + output + "temp/" + args.output + ".html" + " --json " + output + "temp/" + args.output + ".fastp.json"
+    process = sp.Popen(QC_command, shell=True)
+    process.wait()
+    if process.returncode != 0:
+        log_and_print("fastp failed (exit code %s)" % process.returncode, level="error")
+        sys.exit(1)
+    with open(output + args.output + ".coverage", "w") as cov_file:
+        cov_file.write("NA\n")
